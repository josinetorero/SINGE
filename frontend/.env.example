# A aplicação usa o backend Laravel por defeito; defina como 'true' apenas para desenvolvimento isolado com MSW.
VITE_USE_MOCK=false

# URL base da API (o proxy do Vite encaminha /api para o Laravel)
VITE_API_URL=/api

# URL do backend Laravel usado pelo proxy do Vite
VITE_BACKEND_URL=http://localhost:8000
